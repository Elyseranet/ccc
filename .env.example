# Docker Compose and local database settings
APP_PORT=3000
NUXT_DATABASE_PORT=5432
NUXT_DATABASE_HOST=localhost
NUXT_DATABASE_USERNAME=ccc
NUXT_DATABASE_PASSWORD=
NUXT_DATABASE_DATABASE=ccc

# Rate limiter (fenêtre glissante en mémoire, par IP et par route)
NUXT_RATE_LIMIT_WINDOW_MS=60000
NUXT_RATE_LIMIT_MAX_REQUESTS=60
NUXT_RATE_LIMIT_MAX_KEYS=10000
NUXT_RATE_LIMIT_COMPETITORS_SEARCH_WINDOW_MS=60000
NUXT_RATE_LIMIT_COMPETITORS_SEARCH_MAX_REQUESTS=30

# Édition CLOSED : durée (secondes) du Cache-Control public, max-age des lectures publiques
NUXT_CACHE_CLOSED_EDITION_MAX_AGE_SECONDS=3600

# Authentification (B-08) : limites de login (fenêtre de 15 min) et origines autorisées en écriture
NUXT_AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
NUXT_AUTH_LOGIN_RATE_LIMIT_MAX_IP_ATTEMPTS=20
# Origines supplémentaires (séparées par des virgules) autorisées à écrire ; vide = origine de la requête seule
NUXT_AUTH_ALLOWED_ORIGINS=
