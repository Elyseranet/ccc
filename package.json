{
  "name": "ccc",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test:run": "node scripts/test-run.mjs",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:bundle": "nuxt build && vitest run --config vitest.build.config.ts",
    "postinstall": "nuxt prepare",
    "db:typeorm:build": "tsc -p tsconfig.typeorm.json --outDir .typeorm-dist",
    "db:migration:generate": "npm run db:typeorm:build && typeorm migration:generate -d .typeorm-dist/src/server/db/typeorm/data-source.js",
    "db:migration:run": "npm run db:typeorm:build && typeorm migration:run -d .typeorm-dist/src/server/db/typeorm/data-source.js",
    "db:migration:revert": "npm run db:typeorm:build && typeorm migration:revert -d .typeorm-dist/src/server/db/typeorm/data-source.js",
    "test:db": "vitest run -c vitest.db.config.ts",
    "user:unlock": "npm run db:typeorm:build --silent && node .typeorm-dist/src/utils/unlock-user-cli.util.js",
    "user:create-admin": "npm run db:typeorm:build && node .typeorm-dist/src/utils/create-admin-cli.util.js",
    "db:seed:archives": "npm run db:typeorm:build && node .typeorm-dist/src/utils/seed-archives-cli.util.js",
    "typecheck": "node scripts/typecheck.mjs",
    "test:front": "node scripts/test-run.mjs --project front",
    "test:release": "RELEASE_BUILD=true node scripts/test-run.mjs --project front tests/nuxt/front/api-routes.release.test.ts",
    "test:release:e2e": "playwright test --config playwright.release.config.ts",
    "test:a11y": "playwright test --config playwright.config.ts --project=a11y",
    "test:visual": "playwright test --config playwright.config.ts --project=visual"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "dotenv": "^16.6.1",
    "origam": "^2.37.3",
    "pg": "^8.16.3",
    "pinia": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/pngjs": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "nuxt": "^4.6.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "sass": "^1.105.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
