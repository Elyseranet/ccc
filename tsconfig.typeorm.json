{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server/database/**/*.ts",
    "server/utils/logger.util.ts",
    "server/consts/log-event.const.ts",
    "server/enums/**/*.ts",
    "server/interfaces/log-entry.interface.ts",
    "server/types/log-sink.type.ts",
    "shared/**/*.ts"
  ]
}
